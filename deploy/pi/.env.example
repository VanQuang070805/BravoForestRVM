# Địa chỉ LAN của API trên máy tính quản lý. Không dùng localhost ở đây.
MANAGEMENT_API_URL=http://192.168.1.100:4000/api/v1

# Lấy từ bản ghi máy RVM trong trang quản trị.
RVM_MACHINE_ID=replace-with-real-machine-id
RVM_API_KEY=replace-with-newly-issued-machine-api-key

# Giao diện chỉ được công bố trên chính Raspberry Pi.
RVM_DISPLAY_PORT=3002

# Pi AI controller
CAMERA_ONLY=false
MODEL_PATH=deploy/pi/models/best.pt
ARDUINO_SERIAL_PORT=auto
ARDUINO_SERIAL_BAUD=115200

# Chọn backend opencv cho USB camera hoặc picamera2 cho camera CSI của Raspberry Pi.
CAMERA_BACKEND=opencv
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ID quy tắc điểm lấy từ GET /api/v1/machine/scan-options hoặc trang quản trị.
# Model chỉ phân loại vật liệu, vì vậy phải chọn đúng rule kích thước đang dùng cho máy.
PET_RULE_ID=replace-with-pet-rule-id
CAN_RULE_ID=replace-with-can-rule-id

AI_CONFIDENCE=0.70
AI_IMAGE_SIZE=640
AI_STABLE_FRAMES=5
AI_CLEAR_FRAMES=8
SHOW_AI_PREVIEW=false
AI_PREVIEW_MODE=none
AI_PREVIEW_PORT=8765
CONTROLLER_STATE_DB=deploy/pi/controller-state.sqlite3
