# Tên máy tính quản lý trong mạng nội bộ (mDNS). Ví dụ Windows hostname
# VanQuang sẽ được Raspberry Pi tìm thấy tại VanQuang.local.
MANAGEMENT_API_HOST=VanQuang.local
MANAGEMENT_API_PORT=4000
# URL này được watch-api-host.sh tự cập nhật khi IP máy tính thay đổi.
MANAGEMENT_API_URL=http://192.168.1.100:4000/api/v1

# Lấy từ bản ghi máy RVM trong trang quản trị.
RVM_MACHINE_ID=replace-with-real-machine-id
RVM_API_KEY=replace-with-newly-issued-machine-api-key

# Giao diện chỉ được công bố trên chính Raspberry Pi.
RVM_DISPLAY_PORT=3002

# Pi AI controller
CAMERA_ONLY=false
AI_ONLY=false
MODEL_PATH=deploy/pi/models/best_ncnn_model
ARDUINO_SERIAL_PORT=auto
ARDUINO_SERIAL_BAUD=115200
# `legacy` dùng sketch arduino_sorter_test.ino (MOTOR:/SERVO:).
# `bravoforest` dùng firmware giao thức ACCEPT/REJECT/CLEAR trong deploy/pi/arduino.
ARDUINO_PROTOCOL=legacy

# Camera CSI mặc định của Raspberry Pi dùng Picamera2.
CAMERA_BACKEND=picamera2
# Với camera USB, ưu tiên đường dẫn ổn định trong /dev/v4l/by-id thay vì số index.
CAMERA_DEVICE=
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ID quy tắc điểm lấy từ GET /api/v1/machine/scan-options hoặc trang quản trị.
# Dùng 0 cho vật liệu chưa có rule; Pi sẽ từ chối vật liệu đó, không cộng điểm.
# Model chỉ phân loại vật liệu, vì vậy chọn đúng rule áp dụng cho máy.
PET_RULE_ID=replace-with-pet-rule-id
CAN_RULE_ID=replace-with-can-rule-id

AI_CONFIDENCE=0.70
AI_IMAGE_SIZE=320
# Pi chỉ suy luận trên frame mới nhất ở nhịp này; luồng xem camera vẫn độc lập.
AI_INFERENCE_FPS=3
AI_STABLE_FRAMES=3
AI_CLEAR_FRAMES=3
SHOW_AI_PREVIEW=false
AI_PREVIEW_MODE=none
AI_PREVIEW_PORT=8765
CONTROLLER_STATE_DB=deploy/pi/controller-state.sqlite3
