# Copy to .env.prod and replace every placeholder. Use secrets from a secret manager in production.
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
CUSTOMER_DOMAIN=www.example.com
ADMIN_DOMAIN=admin.example.com
KIOSK_DOMAIN=kiosk.example.com
CORS_ORIGINS=https://www.example.com,https://admin.example.com,https://kiosk.example.com

# MariaDB
MARIADB_DATABASE=BravoForest
MARIADB_USER=bravoforest
MARIADB_PASSWORD=replace-with-a-long-url-safe-secret
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-secret
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=BravoForest
DB_USER=bravoforest
DB_PASSWORD=replace-with-a-long-url-safe-secret

# Redis
REDIS_PASSWORD=replace-with-a-long-url-safe-secret
REDIS_URL=redis://:replace-with-a-long-url-safe-secret@redis:6379

# Generate separate random values for each key. Encryption key must be canonical base64 for 32 bytes.
JWT_ACCESS_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000
ENCRYPTION_KEY_BASE64=GENERATE_ME

# Optional integrations
GOOGLE_MAPS_SERVER_API_KEY=
PARTNER_API_ALLOWED_HOSTS=api.partner.example
