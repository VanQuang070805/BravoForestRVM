# Copy to .env.api.prod. Keep app secrets out of .env.prod and never commit the copied file.
# Compose forces production mode and injects DB/Redis coordinates and credentials from .env.prod.
PORT=4000
TRUST_PROXY=1

# Generate distinct random values for JWT keys. Keep ENCRYPTION_KEY_BASE64 identical in API and worker.
# It must be canonical base64 that decodes to 32 bytes.
JWT_ACCESS_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000
ENCRYPTION_KEY_BASE64=GENERATE_ME

# OTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="BravoForest <no-reply@example.com>"
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Optional integrations
GOOGLE_MAPS_SERVER_API_KEY=
PARTNER_API_ALLOWED_HOSTS=api.partner.example
BIN_ALERT_THRESHOLD=90
