# Copy to .env.worker.prod. Keep app secrets out of .env.prod and never commit the copied file.
# Compose forces production mode and injects DB/Redis coordinates and credentials from .env.prod.
# Keep this identical to the API's ENCRYPTION_KEY_BASE64; it must decode to 32 bytes.
ENCRYPTION_KEY_BASE64=GENERATE_ME
PARTNER_API_ALLOWED_HOSTS=api.partner.example
