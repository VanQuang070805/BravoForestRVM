# Local endpoints
NODE_ENV=development
API_PORT=4000
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
RVM_KIOSK_URL=http://localhost:3002

# XAMPP MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=BravoForest
DB_USER=root
DB_PASSWORD=

# Redis (Docker)
REDIS_URL=redis://127.0.0.1:6379

# Replace every secret before exposing the system to a network
JWT_ACCESS_SECRET=change-me-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-with-another-32-character-secret
ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PARTNER_API_ALLOWED_HOSTS=
COOKIE_SECRET=change-me-with-a-long-cookie-secret

# Google Maps browser key; restrict it by referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
